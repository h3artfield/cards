rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Pre-seeded by store owner — read-only from clients; writes via Admin SDK / admin UI
    match /storeSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storeRules/{ruleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Created automatically by the app when customers sign up and submit scans
    match /customers/{customerId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == customerId);
      allow create: if true;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == customerId);
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || resource.data.customerId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isAdmin() || get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.customerId == request.auth.uid;
      allow write: if isAdmin() || request.auth != null;
    }

    match /counters/{docId} {
      allow read, write: if false;
    }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if false;
    }

    match /adminUsers/{userId} {
      allow read, write: if false;
    }
  }
}
