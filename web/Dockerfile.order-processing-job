# Order processing job — Cloud Run Job (Directive 008)
# syntax=docker/dockerfile:1

FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

ENV NODE_ENV=production
ENV REQUIRE_FIRESTORE=true
ENV ORDER_PROCESSING_WORKER=cloud_run_job
ENV CARD_PROCESSING_PIPELINE_MODE=v2_primary
ENV V1_FULL_ANALYSIS_ON_SUBMIT=false
ENV V1_PRICING_ON_SUBMIT=false
ENV V1_ANALYSIS_ASYNC_ENABLED=true

ENTRYPOINT ["npx", "tsx", "scripts/run-order-processing-job.ts"]
CMD []
