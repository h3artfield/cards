# Discord inventory clerk — always-on Cloud Run service
# syntax=docker/dockerfile:1

FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

ENV NODE_ENV=production
ENV REQUIRE_FIRESTORE=true

EXPOSE 8080
ENTRYPOINT ["npx", "tsx", "scripts/discord-inventory-bot.ts"]
CMD []
