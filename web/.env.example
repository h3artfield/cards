# Stripe — store SaaS subscription (Directive 009)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CARD_SCANNER_STORE_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Customer auth — Directive 013
CUSTOMER_SESSION_SECRET=
AUTH_GOOGLE_ENABLED=true
AUTH_APPLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
CUSTOMER_EMAIL_VERIFICATION_ENABLED=true
CUSTOMER_GUEST_MODE_ENABLED=false

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional override for Shopify webhook HMAC verification (defaults to app client secret)
SHOPIFY_WEBHOOK_SECRET=

# Admin session signing (required in cloud; use Secret Manager in staging/prod)
ADMIN_SESSION_SECRET=

# Legacy alias — used if ADMIN_SESSION_SECRET is unset
ADMIN_SECRET=change-me-in-production

# OpenAI — required for card identification from photos
OPENAI_API_KEY=
# gpt-4o recommended for accurate set/collector number reading
OPENAI_VISION_MODEL=gpt-4o
# Event flyer image generation (dall-e-3 retired; use gpt-image-1 or gpt-image-1.5)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536

# Email — Resend (verified domain cardscanner9000.com)
RESEND_API_KEY=
EMAIL_FROM=Card Scanner Reports <reports@cardscanner9000.com>

# PriceCharting daily import report email (Cloud Run Job)
PRICECHARTING_IMPORT_EMAIL_PROVIDER=resend
PRICECHARTING_IMPORT_EMAIL_TO=h3artfield@gmail.com
PRICECHARTING_IMPORT_EMAIL_FROM=reports@cardscanner9000.com
PRICECHARTING_IMPORT_EMAIL_FROM_NAME=Card Scanner Reports

# Customer email when order finishes processing (006W)
ORDER_READY_CUSTOMER_EMAIL_ENABLED=false
ORDER_READY_CUSTOMER_EMAIL_START_AT=2026-07-05T00:00:00.000Z
ORDER_READY_CUSTOMER_EMAIL_FROM=reports@cardscanner9000.com
ORDER_READY_CUSTOMER_EMAIL_FROM_NAME=Card Scanner Reports

# Pokémon TCG API (optional but recommended — free key at https://dev.pokemontcg.io )
POKEMON_TCG_API_KEY=

# OpenCV grading microservice (default http://localhost:8001 — Cloud Run URL in staging)
GRADING_SERVICE_URL=http://localhost:8001

# Runtime public URL (Cloud Run sets APP_URL + NEXT_PUBLIC_APP_URL)
APP_URL=

# PriceCharting daily CSV archive bucket (Cloud Run Job uploads raw/reports here)
PRICECHARTING_ARCHIVE_BUCKET=
PRICECHARTING_API_KEY=

# eBay Developer API (optional — sold/listed comps fallback at https://developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# OpenAI analysis model for buyback reports (defaults to gpt-4o)
OPENAI_ANALYSIS_MODEL=gpt-4o

# Card Flow V2 — observational evidence extraction (default off; set true to enable)
CARD_FLOW_V2_EVIDENCE_ENABLED=false
# Card Flow V2 Phase 2 — catalog suspects + identity lock gate (requires evidence flag)
CARD_FLOW_V2_IDENTITY_ENABLED=false
# Card Flow V2 Phase 3 — shadow market (requires evidence + identity flags)
CARD_FLOW_V2_MARKET_ENABLED=false
CARD_FLOW_V2_MARKET_MAX_SUSPECTS=3
CARD_FLOW_V2_MARKET_ENABLE_EBAY=true
CARD_FLOW_V2_MARKET_ENABLE_PRICECHARTING=true
CARD_FLOW_V2_MARKET_ENABLE_TCGPLAYER=true
# Card Flow V2 Phase 4 — shadow audit vs production pricing (requires evidence + identity + market)
CARD_FLOW_V2_AUDIT_ENABLED=false
# Card Flow V2 Phase 6 — shadow offer preview (requires audit flag; does not change production offers)
CARD_FLOW_V2_OFFER_PREVIEW_ENABLED=false
# Directive 007 — when true, V2 preview may write market/cash/trade (guarded)
CARD_FLOW_V2_OFFER_INFLUENCE=false

# Directive 008 — V2-primary order processing (staging)
ORDER_PROCESSING_WORKER=after
# after | cloud_run_job
CARD_PROCESSING_PIPELINE_MODE=legacy_dual
# legacy_dual | v2_primary
V1_FULL_ANALYSIS_ON_SUBMIT=true
V1_PRICING_ON_SUBMIT=true
V1_ANALYSIS_ASYNC_ENABLED=false
ORDER_PROCESSING_JOB_NAME=order-processing-job
CLOUD_RUN_REGION=us-central1
OPENAI_REQUEST_TIMEOUT_MS=60000
# GPT-5.6 Sol Head Professor final deck review (medium reasoning — target ~1–2 min)
PROFESSOR_BREW_HEAD_PROFESSOR_REASONING_EFFORT=medium
PROFESSOR_BREW_HEAD_PROFESSOR_MAX_OUTPUT_TOKENS=12288
PROFESSOR_BREW_HEAD_PROFESSOR_TIMEOUT_MS=180000
# Sol-directed Professor GUI (staging rollback — legacy brew when false)
PROFESSOR_SOL_DIRECTED_GUI_ENABLED=false
NEXT_PUBLIC_PROFESSOR_SOL_DIRECTED_GUI_ENABLED=false
PROFESSOR_SOL_DIRECTED_LIVE=0
# Sol-directed model (Architect, Constructor, Critic, Head Professor)
PROFESSOR_SOL_DIRECTED_MODEL=gpt-5.6-luna
PROFESSOR_SOL_DIRECTED_REASONING_EFFORT=high
PROFESSOR_BREW_HEAD_PROFESSOR_MODEL=gpt-5.6-luna
ORDER_PROCESSING_STUCK_THRESHOLD_MS=600000
ORDER_PROCESSING_CARD_MAX_MS=900000
ORDER_PROCESSING_JOB_MAX_MS=3600000

# Optional cheaper model for category classifier (defaults to gpt-4o-mini)
OPENAI_CATEGORY_CLASSIFIER_MODEL=gpt-4o-mini

# Firebase client (optional — uses in-memory store without these)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Fail loudly without Firestore when true (set automatically in Cloud Run Dockerfile)
REQUIRE_FIRESTORE=

# Mechanical-space experiment: must stay false. Production interaction writes are forbidden.
ALLOW_PRODUCTION_INTERACTION_WRITES=false

# GetPaird public tournament API (read-only). Never commit a live key.
GETPAIRD_API_KEY=

# Firebase admin — base64-encoded service account JSON (or raw JSON one line)
# On Cloud Run, use Secret Manager or Application Default Credentials via service account IAM
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# Discord inventory clerk (do not commit the bot token)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_STORE_SLUG=
