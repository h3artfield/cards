# PriceCharting daily import job — Cloud Run Job (not the Next.js web service).
# syntax=docker/dockerfile:1

FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

ENV NODE_ENV=production
ENV REQUIRE_FIRESTORE=true

CMD ["npx", "tsx", "scripts/daily-pricecharting.ts"]
