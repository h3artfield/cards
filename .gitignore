# Dependencies
node_modules/
web/node_modules/
functions/node_modules/

# Environment
.env
.env.local
.env.*.local
web/.env.local

# PriceCharting raw CSV archives (contain subscription URLs)
data/pricecharting/raw/
data/pricecharting/reports/
data/scryfall/

# Next.js
web/.next/
web/out/
web/.data/

# Firebase
functions/lib/
.firebase/
firebase-debug.log
*-firebase-adminsdk-*.json
*service*account*.json
**/serviceAccount*.json

# IDE
.idea/
.vscode/

# Generated audit outputs
web/reports/
web/.cache/

# Python bytecode from the mechanical-space training scripts
__pycache__/
*.pyc

# Phase 6A.1 benchmark authority private material (adjudication oracle — not for implementation)
benchmark-authority/**/private/

# Scratch output from local build/measurement runs. These are dot-prefixed
# request/result dumps written next to the app, useful as local fixtures for the
# offline proof scripts but never part of the source tree.
web/.*-test-request.json
web/.*-test-result*.json
web/.last-build.json
web/.omnath-*.json

# Logs from one-off deploy and index-build runs
*.log
_*-blob.txt

