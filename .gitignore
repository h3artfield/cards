# Dependencies
node_modules/
web/node_modules/
functions/node_modules/
scanner/node_modules/
scanner/.expo/

# Environment
.env
.env.local
.env.*.local
web/.env.local

# PriceCharting raw CSV archives (contain subscription URLs)
data/pricecharting/raw/
data/pricecharting/reports/
data/scryfall/

# Deck Rating v1 raw dumps (dated hashes live in MANIFEST; binaries stay local)
web/data/milestones/deck-rating/v1/snapshots/_incoming/
web/data/milestones/deck-rating/v1/snapshots/**/raw/
web/data/milestones/deck-rating/v1/snapshots/**/*.zip
web/data/milestones/deck-rating/v1/snapshots/**/*.jsonl
web/data/milestones/deck-rating/v1/snapshots/**/*.jsonl.gz
web/data/milestones/deck-rating/v1/snapshots/**/AllDeckFiles/
web/data/milestones/deck-rating/v1/snapshots/**/fit/cedh-feature-cache-v1.json
web/data/milestones/deck-rating/v1/snapshots/**/fit/cedh-deck-slim-v1.json
web/data/milestones/deck-rating/v1/tools/
web/data/milestones/deck-rating/v1/snapshots/**/playgroup/api/*.html
web/data/milestones/deck-rating/v1/snapshots/**/playgroup/api/*.xml
web/data/milestones/deck-rating/v1/snapshots/**/playgroup/api/*.xml.gz
web/data/milestones/deck-rating/v1/snapshots/**/playgroup/public-decks/

# Next.js
web/.next/
web/out/
web/.data/

# Firebase
functions/lib/
.firebase/
firebase-debug.log
*-firebase-adminsdk-*.json
*service*account*.json
**/serviceAccount*.json

# IDE
.idea/
.vscode/

# Generated audit outputs
web/reports/
web/.cache/

# Customer UX Playwright pack (auth session + run artifacts)
web/e2e/.auth/
web/e2e/artifacts/
web/test-results/
web/playwright-report/
web/blob-report/

# Python bytecode from the mechanical-space training scripts
__pycache__/
*.pyc

# Phase 6A.1 benchmark authority private material (adjudication oracle — not for implementation)
benchmark-authority/**/private/

# Scratch output from local build/measurement runs. These are dot-prefixed
# request/result dumps written next to the app, useful as local fixtures for the
# offline proof scripts but never part of the source tree.
web/.*-test-request.json
web/.*-test-result*.json
web/.last-build.json
web/.omnath-*.json

# Logs from one-off deploy and index-build runs
*.log
_*-blob.txt

